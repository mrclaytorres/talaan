{
  "name": "Talaan",
  "version": "1.0.0",
  "description": "Talaan Trading Journal — Desktop",
  "author": {
    "name": "",
    "email": ""
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "license": "MIT",
  "main": "build/src/index.js",
  "scripts": {
    "build": "tsc && npx @electron/rebuild",
    "electron:start-live": "node ./live-runner.js",
    "electron:start": "npm run build && electron --inspect=5858 ./",
    "electron:pack": "npm run build && electron-builder build --dir -c ./electron-builder.config.json",
    "electron:make": "npm run build && electron-builder build -c ./electron-builder.config.json -p always",
    "electron:build-linux": "npm run build && electron-builder build --linux AppImage deb -c ./electron-builder.config.json"
  },
  "dependencies": {
    "@capacitor-community/electron": "^5.0.0",
    "@capacitor-community/sqlite": "^8.0.0",
    "better-sqlite3-multiple-ciphers": "*",
    "chokidar": "~3.5.3",
    "crypto-js": "^4.2.0",
    "electron-is-dev": "~2.0.0",
    "electron-json-storage": "^4.6.0",
    "electron-serve": "~1.1.0",
    "electron-unhandled": "~4.0.1",
    "electron-updater": "^5.3.0",
    "electron-window-state": "^5.0.3",
    "jszip": "^3.10.1",
    "node-fetch": "2.6.7"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@types/better-sqlite3": "^7.6.8",
    "@types/crypto-js": "^4.2.1",
    "@types/electron-json-storage": "^4.5.4",
    "electron": "25.8.4",
    "electron-builder": "24.6.4",
    "typescript": "^5.0.4"
  },
  "keywords": [
    "capacitor",
    "electron"
  ]
}
